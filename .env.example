# Load locally with your service manager. Never put keys or passwords here.
LATCH_PUBLIC_ORIGIN=https://localhost:8443
LATCH_DATA_DIR=var
LATCH_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
LATCH_MODEL_ID=
LATCH_INFERENCE_KEY_FILE=
LATCH_SOURCE_TASK_FILE=
# Worker probe settings belong on the private Vultr worker only.
LATCH_BROWSER_IMAGE=
LATCH_EGRESS_NETWORK=
LATCH_EGRESS_PROXY=
LATCH_SECCOMP_FILE=

# Application server only; each file must be owned and mode 0600.
LATCH_DATABASE_URL_FILE=private/database-url
LATCH_CSRF_KEY_FILE=private/csrf-key
LATCH_STATIC_DIR=dist
