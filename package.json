{
  "name": "latch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.2"
  },
  "packageManager": "npm@10.8.2",
  "scripts": {
    "check:runtime": "node scripts/check_node.mjs",
    "dev": "bash scripts/dev.sh",
    "build": "tsc --noEmit && vite build",
    "check:types": "tsc --noEmit",
    "contracts": ".venv/bin/python -m services.api.operator openapi && openapi-typescript packages/contracts/openapi.json -o packages/contracts/api.d.ts",
    "test:browser": "PLAYWRIGHT_BROWSERS_PATH=.tools/browsers .venv/bin/python scripts/check_browser.py"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.3",
    "lucide-react": "1.67.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "axe-core": "4.14.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
